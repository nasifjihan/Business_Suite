# ─────────────────────────────────────────────────────────────────────
# frontend/.env.local.example
#
# Copy to .env.local and adjust if your backend is not on :5000:
#   cp .env.local.example .env.local        (Windows: copy .env.local.example .env.local)
#
# ⚠️ NEXT_PUBLIC_* values are inlined into the browser bundle at STARTUP.
#    Changing this file requires restarting `npm run dev` — a hot reload
#    will NOT pick up the new value.
# ─────────────────────────────────────────────────────────────────────

# Base URL of the REST API, INCLUDING the /api/v1 prefix.
#
#   Backend running locally (npm run dev)  -> http://localhost:5000/api/v1
#   Full Docker stack (nginx on port 80)   -> http://localhost/api/v1
#
# The Docker value points at nginx, not the backend container, so the UI and
# the API share one origin. That avoids CORS preflight and SameSite cookie
# complications. See docker-compose.yml.
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# ── UI and API on DIFFERENT sites (e.g. UI on Vercel, API on Render) ───
# Set these in the Vercel project's Environment Variables, NOT in .env.local.
#
#   NEXT_PUBLIC_API_URL=/api/v1
#   API_PROXY_TARGET=https://your-api-host.example.com
#
# Why the relative URL: the refresh token is an HTTP-only cookie, and across
# sites the browser treats it as a THIRD-PARTY cookie, which Safari and Firefox
# block by default. Login then appears to succeed, but the first reload cannot
# call POST /auth/refresh and the user is bounced to /login?expired=1.
# Proxying /api/v1 through the UI's own origin (next.config.ts `rewrites`)
# makes the cookie first-party again.
#
# API_PROXY_TARGET is deliberately NOT a NEXT_PUBLIC_* var — it is read at
# build time by next.config.ts to configure the rewrite, and never ships to the
# browser. Leave it unset locally (and in Docker): without it there is no
# rewrite at all, which is correct because both of those are already
# same-origin.

# Display name used in page titles and the app header.
NEXT_PUBLIC_APP_NAME=Business Suite
