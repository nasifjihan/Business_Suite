# ─────────────────────────────────────────────────────────────────────
# frontend/.env.local.example
#
# Copy to .env.local and adjust if your backend is not on :5000:
#   cp .env.local.example .env.local        (Windows: copy .env.local.example .env.local)
#
# ⚠️ NEXT_PUBLIC_* values are inlined into the browser bundle at STARTUP.
#    Changing this file requires restarting `npm run dev` — a hot reload
#    will NOT pick up the new value.
# ─────────────────────────────────────────────────────────────────────

# Base URL of the REST API, INCLUDING the /api/v1 prefix.
#
#   Backend running locally (npm run dev)  -> http://localhost:5000/api/v1
#   Full Docker stack (nginx on port 80)   -> http://localhost/api/v1
#
# The Docker value points at nginx, not the backend container, so the UI and
# the API share one origin. That avoids CORS preflight and SameSite cookie
# complications. See docker-compose.yml.
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Display name used in page titles and the app header.
NEXT_PUBLIC_APP_NAME=Business Suite
