# ─────────────────────────────────────────────────────────────────────
# backend/.env.example
#
# Every variable here is validated at boot by the Zod schema in
# src/config/env.ts. That file is the single source of truth: if a name
# does not appear there, the app does NOT read it. Keep the two in sync —
# a variable documented here but absent from the schema is silently
# ignored, which is worse than not documenting it at all.
#
# Copy to .env and fill in:  cp .env.example .env
# ─────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────
# NODE_ENV must be exactly one of: development | test | production
NODE_ENV=development
PORT=5000

# ── Frontend CORS (PROD: single exact origin — never a wildcard) ──────
FRONTEND_URL=http://localhost:3000
# Cookie domain for the HTTP-only refresh token.
COOKIE_DOMAIN=localhost

# ── Database ─────────────────────────────────────────────────────────
# Must be a valid URL or the app refuses to boot.
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/business_suite?schema=public
# NOTE: there is deliberately no DIRECT_URL here. Under Prisma 7 the datasource
# block in schema.prisma carries no url, and prisma.config.ts reads DATABASE_URL
# only — so a DIRECT_URL would be dead config. If you later move to a pooled
# provider (Neon/Supabase PgBouncer) that needs a direct migration connection,
# add it to prisma.config.ts first, then document it here.

# ── JWT (each secret min 16 chars; use long random values in prod) ────
JWT_ACCESS_SECRET=dev-access-secret-change-me-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-in-production
# Expressed as zeit/ms duration strings, e.g. 15m, 1h, 7d
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ── Rate Limiting ────────────────────────────────────────────────────
# Global ceiling applied by standardLimiter. The stricter per-route
# ceilings (auth 10/window, crud 500, authed 2000) are constants in
# src/middleware/rateLimiter.ts.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Bypasses ALL limiters, but ONLY when NODE_ENV=development. Use this while
# clicking through the login form by hand instead of raising the ceilings —
# that keeps the production values and the integration test in agreement.
DISABLE_RATE_LIMIT=false
