# ── Server ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Frontend CORS (PROD: single origin — NO wildcard) ─────────
FRONTEND_URL=http://localhost:3000

# ── Database (Neon/Supabase PgBouncer = DATABASE_URL pooling) ──
DATABASE_URL=postgresql://user:password@host-pooler.region.db.com:5432/bs_db?schema=public&pgbouncer=true
DIRECT_URL=postgresql://user:password@host.region.db.com:5432/bs_db?schema=public
# For Render PostgreSQL: copy Internal Database URL above both. Remove pgbouncer=true if not pooling.

# ── JWT (min 32 chars each, rotate in prod) ────────────────────
JWT_ACCESS_SECRET=replace_with_32plus_char_random_access_secret
JWT_REFRESH_SECRET=replace_with_32plus_char_random_refresh_secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# ── Password Hashing ───────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── Email (SMTP) ───────────────────────────────────────────────
EMAIL_FROM=noreply@yourdomain.com
EMAIL_HOST=smtp.yourprovider.com
EMAIL_PORT=587
EMAIL_USER=your-smtp-username
EMAIL_PASS=your-smtp-password

# ── Rate Limiting Tuning ───────────────────────────────────────
# Toggles in middleware; optional overrides:
# GLOBAL_RATE_LIMIT_MAX=1000
# GLOBAL_RATE_LIMIT_WINDOW_MS=900000

# ── Tracing (optional) ─────────────────────────────────────────
# ENABLE_AUDIT_LOG=true
